# Server runtime only. Copy into the host's encrypted environment settings.
# Google OAuth client ID/secret belong ONLY in Supabase provider settings.
# No VITE_ variables are required. Every VITE_ value is public.
APP_ORIGIN=
APP_ENV=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HMAC_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Public canonical HTTPS origin, used only to build SEO pages. Empty keeps previews noindex.
SITE_ORIGIN=
