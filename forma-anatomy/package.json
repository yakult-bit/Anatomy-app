{
  "name": "forma-anatomy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite",
    "build": "npm run quiz:precompute && npm run check && vite build && npm run check:client",
    "start": "vite preview --host 0.0.0.0",
    "test": "node scripts/verify-z-anatomy.mjs",
    "lint": "npm run check",
    "models": "node scripts/import-z-anatomy.mjs",
    "models:fetch": "python scripts/fetch-z-anatomy.py",
    "models:landmarks": "node scripts/align-z-landmarks.mjs",
    "test:board": "node scripts/verify-study-board.mjs",
    "check": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json",
    "test:security": "node scripts/test-security.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "test:identify": "node scripts/test-identify.mjs",
    "check:client": "node scripts/check-client-boundary.mjs",
    "build:functions": "node scripts/build-pages.mjs",
    "dev:full": "wrangler pages dev dist --port 8788",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:click": "node scripts/test-click.mjs",
    "quiz:precompute": "node scripts/precompute-quiz.mjs && node scripts/precompute-recognition-context.mjs && node scripts/precompute-quiz.mjs --female && node scripts/precompute-recognition-context.mjs --female",
    "quiz:check": "node scripts/precompute-quiz.mjs --check && node scripts/precompute-recognition-context.mjs --check && node scripts/precompute-quiz.mjs --female --check && node scripts/precompute-recognition-context.mjs --female --check",
    "predev": "npm run quiz:check",
    "test:quiz-setup": "node scripts/test-recognition-setup.mjs",
    "test:quiz-browser": "playwright test",
    "predev:full": "npm run build",
    "deploy:pages": "npm run build && wrangler pages deploy dist",
    "test:pages": "node scripts/test-pages.mjs",
    "test:pages-config": "node scripts/test-pages-config.mjs",
    "test:quiz-session": "node scripts/test-recognition-session.mjs",
    "test:quiz-modes": "node scripts/test-quiz-modes.mjs",
    "test:find-no-clues": "node scripts/test-find-no-clues.mjs",
    "models:female": "python scripts/fetch-nih-hra.py && node scripts/import-nih-hra.mjs && npm run quiz:precompute && node scripts/test-nih-meshes.mjs && node scripts/report-nih-hra.mjs",
    "test:female": "node scripts/test-female.mjs && node scripts/test-nih-meshes.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "test:public-pages": "node scripts/test-public-pages.mjs",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@hookform/resolvers": "5.7.1",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@sentry/cloudflare": "10.73.0",
    "@shadcn/react": "0.3.0",
    "@supabase/supabase-js": "2.115.0",
    "@types/three": "0.185.4",
    "@upstash/redis": "1.38.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "draco3dgltf": "1.5.7",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "7.85.0",
    "react-resizable-panels": "4.12.2",
    "recharts": "3.8.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "three": "0.185.1",
    "three-mesh-bvh": "0.8.3",
    "vaul": "1.1.2",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260906.1",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "type": "module"
}
